# Amazon Creators API (the PA-API 5.0 replacement, retired May 2026).
# Copy this file to .env and fill in the secrets. NEVER commit .env.
# Get these in Amazon Associates Central -> Creators API -> Create App.
CREATORS_CLIENT_ID=amzn1.application-oa2-client...
CREATORS_CLIENT_SECRET=amzn1.oa2-cs.v1...
AMAZON_PARTNER_TAG=coffeedant03-20
