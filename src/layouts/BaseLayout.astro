---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Crumb { name: string; url: string; }
interface Props {
  title: string;
  description?: string | null;
  canonicalURL?: string | null;
  ogTitle?: string | null;
  ogDescription?: string | null;
  ogImage?: string | null;
  ogType?: string;
  noindex?: boolean;
  breadcrumbs?: Crumb[];
}

const {
  title,
  description = 'Honest espresso machine reviews, buying guides, and brewing tips.',
  canonicalURL = new URL(Astro.url.pathname, Astro.site).toString(),
  ogTitle,
  ogDescription,
  ogImage = '/og-default.png',
  ogType = 'website',
  noindex = false,
  breadcrumbs = [],
} = Astro.props;

const siteName = 'Coffeedant';
const fullTitle = title?.includes(siteName) ? title : `${title} | ${siteName}`;
const desc = description ?? '';
const ogImageURL = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;

const ldGraph: any[] = [
  { '@type': 'Organization', '@id': `${Astro.site}#org`, name: siteName, url: String(Astro.site) },
  { '@type': 'WebSite', '@id': `${Astro.site}#site`, name: siteName, url: String(Astro.site), publisher: { '@id': `${Astro.site}#org` } },
];
if (breadcrumbs.length > 1) {
  ldGraph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.url, Astro.site).toString() })),
  });
}
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': ldGraph });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    {desc && <meta name="description" content={desc} />}
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={ogTitle || fullTitle} />
    {(ogDescription || desc) && <meta property="og:description" content={ogDescription || desc} />}
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle || fullTitle} />
    {(ogDescription || desc) && <meta name="twitter:description" content={ogDescription || desc} />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    <Header />
    {breadcrumbs.length > 1 && (
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        {breadcrumbs.map((c, i) => (
          <>{i > 0 && <span> / </span>}{i < breadcrumbs.length - 1 ? <a href={c.url}>{c.name}</a> : <span>{c.name}</span>}</>
        ))}
      </nav>
    )}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
