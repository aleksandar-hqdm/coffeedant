---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { machines, TYPE_LABEL, MILK_LABEL, FEATURES, redditUrl } from '../../lib/catalog';
const payload = {
  features: FEATURES,
  machines: machines.map((m) => ({
    slug: m.slug, label: m.label, brand: m.brand, route: m.route, image: m.image,
    rating: m.rating, displayPrice: m.displayPrice, buyUrl: m.buyUrl,
    typeLabel: TYPE_LABEL[m.type] || m.type, milkLabel: MILK_LABEL[m.milk] || m.milk,
    grinder: m.grinder, dims: m.dims, badges: m.badges, scores: m.scores,
    reddit: redditUrl(m.brand, m.label),
  })),
};
const json = JSON.stringify(payload).replace(/</g, '\\u003c');
---
<BaseLayout
  title="Compare Espresso Machines Side by Side"
  description="Put up to three espresso machines side by side: price, our feature scores (espresso, milk, build, ease, value), key specs, and dimensions."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Compare', url: '/compare/' }]}
>
  <div class="cmp">
    <header class="cmp__head">
      <h1>Compare machines</h1>
      <p>Pick up to three machines for a deep side-by-side: our feature scores, specs, and dimensions.</p>
    </header>
    <div class="cmp__grid" id="cmp-grid"></div>
  </div>

  <script id="cmp-data" type="application/json" set:html={json} />
  <script is:inline>
    (() => {
      const { features: FEAT, machines: M } = JSON.parse(document.getElementById('cmp-data').textContent);
      const bySlug = Object.fromEntries(M.map((m) => [m.slug, m]));
      const grid = document.getElementById('cmp-grid');
      let slots = [null, null, null];
      const preset = new URLSearchParams(location.search).get('m');
      if (preset) preset.split(',').slice(0, 3).forEach((s, i) => { if (bySlug[s]) slots[i] = s; });
      while (slots.length < 3) slots.push(null);
      const esc = (s) => (s == null ? '' : String(s).replace(/"/g, '&quot;'));

      function syncUrl() {
        const sel = slots.filter(Boolean);
        history.replaceState(null, '', location.pathname + (sel.length ? '?m=' + sel.join(',') : ''));
      }
      function bar(label, score) {
        const pct = score != null ? Math.max(4, Math.round(score * 10)) : 0;
        return `<div class="sc"><span class="sc__l">${label}</span><span class="sc__track"><span class="sc__fill" style="width:${pct}%"></span></span><span class="sc__v">${score != null ? score : '—'}</span></div>`;
      }
      function row(lbl, val) { return `<div class="cmp__row"><span class="cmp__lbl">${lbl}</span><span class="cmp__val">${val}</span></div>`; }
      function col(slug, i) {
        if (!slug) {
          return `<div class="cmp__col cmp__col--empty"><div class="cmp__picker">
            <input type="text" class="cmp__search" data-slot="${i}" placeholder="Add a machine..." aria-label="Search machines">
            <ul class="cmp__results" data-results="${i}"></ul></div></div>`;
        }
        const m = bySlug[slug];
        const hasScores = m.scores && Object.keys(m.scores).length;
        const scoreBlock = hasScores
          ? `<div class="cmp__scores">${FEAT.map((f) => bar(f.label, m.scores[f.key] ?? null)).join('')}</div>`
          : '<p class="cmp__na cmp__na--block">Feature scores not available</p>';
        const badges = (m.badges || []).length ? `<div class="cmp__badges">${m.badges.map((b) => `<span>${b}</span>`).join('')}</div>` : '';
        return `<div class="cmp__col">
          <button class="cmp__remove" data-remove="${i}" aria-label="Remove">&times;</button>
          <a class="cmp__media" href="${m.route}">${m.image ? `<img src="${esc(m.image)}" alt="${esc(m.label)}" loading="lazy">` : '<span>No image</span>'}</a>
          <span class="cmp__brand">${m.brand}</span>
          <a class="cmp__name" href="${m.route}">${m.label}</a>
          ${row('Price', m.displayPrice || '<span class="cmp__na">See Amazon</span>')}
          ${row('Our overall', m.rating ? '&#9733; ' + m.rating + ' / 5' : '<span class="cmp__na">n/a</span>')}
          <p class="cmp__sec">Feature scores (/10)</p>
          ${scoreBlock}
          <p class="cmp__sec">Specs</p>
          ${row('Type', m.typeLabel)}
          ${row('Milk', m.milkLabel)}
          ${row('Grinder', m.grinder ? 'Built-in' : 'None')}
          ${row('Dimensions', m.dims ? m.dims + ' mm' : '<span class="cmp__na">n/a</span>')}
          ${badges}
          <div class="cmp__actions">
            <a class="cmp__buy" href="${esc(m.buyUrl)}" target="_blank" rel="nofollow sponsored noopener">Check price</a>
            <a class="cmp__review" href="${m.route}">Read review</a>
          </div>
          <a class="cmp__reddit" href="${esc(m.reddit)}" target="_blank" rel="nofollow noopener">See r/espresso discussion &#8599;</a>
        </div>`;
      }
      function render() {
        grid.innerHTML = slots.map((s, i) => col(s, i)).join('');
        grid.querySelectorAll('[data-remove]').forEach((b) => b.addEventListener('click', () => { slots[+b.dataset.remove] = null; render(); syncUrl(); }));
        grid.querySelectorAll('.cmp__search').forEach((inp) => {
          const i = +inp.dataset.slot;
          const results = grid.querySelector(`[data-results="${i}"]`);
          inp.addEventListener('input', () => {
            const q = inp.value.trim().toLowerCase();
            if (!q) { results.innerHTML = ''; return; }
            const chosen = new Set(slots.filter(Boolean));
            const hits = M.filter((m) => !chosen.has(m.slug) && (m.label + ' ' + m.brand).toLowerCase().includes(q)).slice(0, 8);
            results.innerHTML = hits.map((m) => `<li><button data-pick="${m.slug}">${m.brand} ${m.label}</button></li>`).join('');
            results.querySelectorAll('[data-pick]').forEach((btn) => btn.addEventListener('click', () => { slots[i] = btn.dataset.pick; render(); syncUrl(); }));
          });
        });
      }
      render(); syncUrl();
    })();
  </script>
</BaseLayout>

<style>
  .cmp { max-width: var(--container); margin: 0 auto; padding: 1.75rem 1.25rem 3rem; }
  .cmp__head { margin-bottom: 1.5rem; }
  .cmp__head h1 { margin: 0 0 0.35rem; font-size: clamp(1.7rem, 4vw, 2.4rem); }
  .cmp__head p { margin: 0; color: var(--color-muted, #5b6472); }
  .cmp__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: start; }
  .cmp__col { position: relative; border: 1px solid var(--line-soft); border-radius: var(--radius); padding: 1.1rem; background: var(--surface); box-shadow: var(--shadow-xs); }
  .cmp__col--empty { display: flex; align-items: center; justify-content: center; min-height: 260px; border-style: dashed; border-color: var(--line); background: var(--canvas-2); box-shadow: none; }
  .cmp__picker { width: 100%; }
  .cmp__search { width: 100%; padding: 0.6rem 0.75rem; border: 1px solid var(--color-line, #ddd); border-radius: 8px; font: inherit; }
  .cmp__results { list-style: none; margin: 0.5rem 0 0; padding: 0; max-height: 240px; overflow: auto; }
  .cmp__results button { width: 100%; text-align: left; background: none; border: 0; padding: 0.5rem; border-radius: 6px; cursor: pointer; font: inherit; }
  .cmp__results button:hover { background: var(--color-soft, #f3f3f3); }
  .cmp__remove { position: absolute; top: 0.5rem; right: 0.5rem; border: 0; background: var(--color-soft, #eee); border-radius: 999px; width: 26px; height: 26px; cursor: pointer; font-size: 1rem; line-height: 1; }
  .cmp__media { display: flex; align-items: center; justify-content: center; height: 150px; background: radial-gradient(120% 100% at 50% 0%, #fff, var(--canvas-2)); border-radius: var(--radius-sm); padding: 0.75rem; }
  .cmp__media img { max-width: 100%; max-height: 100%; object-fit: contain; mix-blend-mode: multiply; }
  .cmp__brand { display: block; margin-top: 0.85rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-3); font-weight: 600; }
  .cmp__name { display: block; font-family: var(--font-display); font-weight: 540; font-size: 1.2rem; letter-spacing: -0.01em; color: var(--ink); text-decoration: none; line-height: 1.2; margin: 0.15rem 0 0.6rem; }
  .cmp__name:hover { color: var(--copper-deep); }
  .cmp__sec { margin: 0.9rem 0 0.4rem; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted, #888); font-weight: 700; }
  .cmp__row { display: flex; justify-content: space-between; gap: 0.5rem; padding: 0.32rem 0; border-top: 1px solid var(--color-line, #eee); font-size: 0.86rem; }
  .cmp__lbl { color: var(--color-muted, #777); }
  .cmp__val { font-weight: 600; text-align: right; }
  .cmp__na { color: var(--color-muted, #999); font-weight: 400; }
  .cmp__na--block { font-size: 0.84rem; padding: 0.4rem 0; }
  .cmp__scores { display: flex; flex-direction: column; gap: 0.4rem; }
  .sc { display: grid; grid-template-columns: 1fr 70px 26px; align-items: center; gap: 0.5rem; font-size: 0.8rem; }
  .sc__l { color: var(--color-text, #333); }
  .sc__track { height: 7px; background: var(--color-soft, #eee); border-radius: 999px; overflow: hidden; }
  .sc__fill { display: block; height: 100%; background: var(--color-accent, #16a34a); border-radius: 999px; }
  .sc__v { font-weight: 700; text-align: right; font-size: 0.78rem; }
  .cmp__badges { display: flex; flex-wrap: wrap; gap: 0.3rem; margin-top: 0.5rem; }
  .cmp__badges span { font-size: 0.72rem; background: var(--color-soft, #f1efec); color: var(--color-text, #444); padding: 0.15rem 0.5rem; border-radius: 999px; }
  .cmp__actions { display: flex; flex-direction: column; gap: 0.4rem; margin-top: 0.9rem; }
  .cmp__buy { text-align: center; background: var(--copper-deep); color: #fff; font-weight: 620; padding: 0.55rem; border-radius: 999px; text-decoration: none; font-size: 0.85rem; transition: background 0.2s var(--ease); }
  .cmp__buy:hover { background: var(--copper-dark); color: #fff; }
  .cmp__review { text-align: center; border: 1px solid var(--line); color: var(--ink); font-weight: 600; padding: 0.55rem; border-radius: 999px; text-decoration: none; font-size: 0.85rem; }
  .cmp__review:hover { background: var(--canvas-2); }
  .cmp__reddit { display: block; text-align: center; margin-top: 0.5rem; font-size: 0.8rem; color: var(--color-muted, #777); text-decoration: none; }
  .cmp__reddit:hover { color: var(--color-brand, #6f4e37); text-decoration: underline; }
  @media (max-width: 640px) { .cmp__grid { grid-template-columns: 1fr; } }
</style>
