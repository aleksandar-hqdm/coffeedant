---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Coffeedant"
  description="Honest espresso machine reviews, buying guides, and brewing tips."
>
  <main>
    <section class="hero">
      <h1>Coffeedant</h1>
      <p class="tagline">Honest espresso machine reviews, buying guides, and brewing tips.</p>
      <p class="note">The site is being rebuilt. New reviews and guides coming soon.</p>
    </section>
  </main>
</BaseLayout>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }
  .hero {
    text-align: center;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }
  .tagline {
    font-size: 1.25rem;
    color: var(--color-muted);
    margin: 0 0 2rem;
  }
  .note {
    color: var(--color-muted);
    font-size: 0.95rem;
  }
</style>
