---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const home = pages.find((p) => p.data.route === '/');
const data = home?.data;
---
<BaseLayout
  title={data?.seoTitle || 'Coffeedant'}
  description={data?.description || 'Honest espresso machine reviews, buying guides, and brewing tips.'}
  canonicalURL={data?.canonical}
  ogTitle={data?.ogTitle}
  ogDescription={data?.ogDescription}
  ogImage={data?.ogImage}
>
  {data ? (
    <div class="cd-home" set:html={data.bodyHtml} />
  ) : (
    <section class="cd-article">
      <h1>Coffeedant</h1>
      <p>Honest espresso machine reviews, buying guides, and brewing tips.</p>
    </section>
  )}
</BaseLayout>

<style>
  .cd-home { max-width: var(--container); margin: 0 auto; padding: 1.5rem 1.25rem 3rem; }
</style>
