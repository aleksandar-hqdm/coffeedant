---
import BaseLayout from '../layouts/BaseLayout.astro';
import nav from '../data/nav.json';
import machinesRaw from '../data/machines.json';
import amazon from '../data/amazon.json';
import asinMap from '../data/asins.json';
import { liveProduct, searchUrl, formatUpdated } from '../lib/product';

type Machine = { slug: string; label: string; brand: string; route: string; image: string | null; rating: number | null; price: string | null; asin: string | null; amazonUrl: string | null; type: string; grinder: boolean; milk: string };
const machines = machinesRaw as Machine[];
const amz = amazon as Record<string, { title?: string | null; image?: string; price?: string; displayPrice?: string; url?: string }>;
const asins = asinMap as Record<string, string>;
const { catalog, guides } = nav as { catalog: { brand: string; slug: string; route: string; count: number; avgRating: number | null }[]; guides: { name: string; route: string }[] };

const enrich = (m: Machine) => {
  const live = liveProduct(m, amz, asins);
  return { ...m, image: live?.image || m.image, displayPrice: live?.displayPrice || null, lastUpdated: live?.displayPrice ? formatUpdated(live?.updated) : null, buyUrl: live?.url || searchUrl(m.brand, m.label) };
};
const topRated = machines
  .filter((m) => m.rating != null && m.rating >= 4.5 && m.image)
  .sort((a, b) => (b.rating! - a.rating!))
  .slice(0, 8)
  .map(enrich);
const reviewCount = machines.length;
const brands = [...catalog].sort((a, b) => b.count - a.count);
---
<BaseLayout
  title="Coffeedant: Honest Espresso Machine Reviews & Buying Guides"
  description="Independent, hands-on espresso machine reviews, buying guides, and brewing tips. Take the quiz to find the machine that fits you, with live prices and ratings."
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__inner">
      <p class="hero__eyebrow">Independent, barista-tested reviews</p>
      <h1>Find the right espresso machine, without the guesswork.</h1>
      <p class="hero__sub">{reviewCount} machines bought, tested, and scored on what actually matters: the shot, the steam, the build, and the price.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href="/quiz/">Take the Quiz: Find your machine</a>
        <a class="btn btn--ghost" href="/espresso-machine/">Browse all reviews</a>
      </div>
      <p class="hero__trust">No sponsored reviews. I buy the gear and report what holds up.</p>
    </div>
  </section>

  <div class="home">
    <!-- Top rated -->
    <section class="block">
      <div class="block__head">
        <h2>Top-rated machines</h2>
        <a class="block__more" href="/espresso-machine/">See all &rarr;</a>
      </div>
      <div class="card-grid">
        {topRated.map((m) => (
          <div class="mcard">
            <a class="mcard__media" href={m.route}>{m.image ? <img src={m.image} alt={m.label} loading="lazy" /> : <span class="mcard__ph">No image</span>}</a>
            <div class="mcard__body">
              <span class="mcard__brand">{m.brand}</span>
              <a class="mcard__title" href={m.route}>{m.label}</a>
              <div class="mcard__meta">
                <span class="mcard__rating">&#9733; {m.rating}</span>
                {m.displayPrice && <span class="mcard__price">{m.displayPrice}</span>}
              </div>
              {m.lastUpdated && <span class="mcard__updated">Last updated: {m.lastUpdated}</span>}
              <div class="mcard__actions">
                <a class="mcard__buy" href={m.buyUrl} target="_blank" rel="nofollow sponsored noopener">Check price</a>
                <a class="mcard__review" href={m.route}>Review</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Quiz band -->
    <section class="quizband">
      <div class="quizband__text">
        <h2>Not sure where to start?</h2>
        <p>Answer five quick questions and get a shortlist matched to how you drink, your skill level, and your budget.</p>
      </div>
      <a class="btn btn--primary" href="/quiz/">Find your machine &rarr;</a>
    </section>

    <!-- Shop by use -->
    <section class="block">
      <div class="block__head"><h2>Shop by what you need</h2></div>
      <div class="tile-grid">
        {guides.map((g) => (<a class="tile" href={g.route}><span>{g.name}</span><span class="tile__arrow">&rarr;</span></a>))}
        <a class="tile tile--accent" href="/quiz/"><span>Help me choose (quiz)</span><span class="tile__arrow">&rarr;</span></a>
      </div>
    </section>

    <!-- Shop by brand -->
    <section class="block">
      <div class="block__head"><h2>Shop by brand</h2><a class="block__more" href="/espresso-machine/">All brands &rarr;</a></div>
      <div class="brand-grid">
        {brands.slice(0, 18).map((b) => (
          <a class="bpill" href={b.route}>
            <span class="bpill__name">{b.brand}</span>
            <span class="bpill__meta">{b.count} {b.count === 1 ? 'review' : 'reviews'}{b.avgRating ? ` · ★ ${b.avgRating}` : ''}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Trust -->
    <section class="trust">
      <h2>Why trust Coffeedant</h2>
      <div class="trust__grid">
        <div class="trust__item"><h3>I buy the gear</h3><p>Machines are purchased at retail where possible. Brands do not see drafts and cannot influence scores.</p></div>
        <div class="trust__item"><h3>Measured testing</h3><p>Temperature stability, shot yield, flow behavior, and milk texture, not marketing claims.</p></div>
        <div class="trust__item"><h3>No sponsored reviews</h3><p>Funded by affiliate links at no extra cost to you. The recommendation is the same either way.</p></div>
      </div>
      <a class="trust__link" href="/testing/">How we test &rarr;</a>
    </section>
  </div>
</BaseLayout>

<style>
  .hero { background: linear-gradient(160deg, #2a1d14 0%, #3c2a1c 55%, #4a3322 100%); color: #fdfaf6; }
  .hero__inner { max-width: 880px; margin: 0 auto; padding: 4rem 1.25rem 4.25rem; text-align: center; }
  .hero__eyebrow { text-transform: uppercase; letter-spacing: 0.14em; font-size: 0.8rem; font-weight: 700; color: #7ee0a3; margin: 0 0 0.85rem; }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.1; letter-spacing: -0.02em; margin: 0 0 1rem; }
  .hero__sub { font-size: clamp(1rem, 2vw, 1.2rem); color: #e7ddd2; max-width: 38ch; margin: 0 auto 1.75rem; }
  .hero__cta { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
  .hero__trust { margin: 1.5rem 0 0; font-size: 0.9rem; color: #b7a896; }

  .btn { display: inline-flex; align-items: center; justify-content: center; padding: 0.85rem 1.5rem; border-radius: 999px; font-weight: 700; text-decoration: none; transition: transform 0.08s ease, background 0.15s ease, box-shadow 0.15s ease; }
  .btn--primary { background: var(--color-accent); color: #fff; box-shadow: 0 10px 24px rgba(22, 163, 74, 0.3); }
  .btn--primary:hover { background: #15803d; transform: translateY(-1px); }
  .btn--ghost { background: rgba(255, 255, 255, 0.08); color: #fff; border: 1px solid rgba(255, 255, 255, 0.25); }
  .btn--ghost:hover { background: rgba(255, 255, 255, 0.16); }

  .home { max-width: var(--container); margin: 0 auto; padding: 0 1.25rem; }
  .block { padding: 3rem 0 0.5rem; }
  .block__head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 1.25rem; gap: 1rem; }
  .block__head h2 { font-size: clamp(1.4rem, 3vw, 1.9rem); margin: 0; }
  .block__more { font-weight: 600; color: var(--color-brand); text-decoration: none; white-space: nowrap; }
  .block__more:hover { text-decoration: underline; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 1.1rem; }
  .mcard { display: flex; flex-direction: column; border: 1px solid var(--color-line); border-radius: 14px; overflow: hidden; background: #fff; transition: box-shadow 0.15s ease, transform 0.15s ease; }
  .mcard:hover { box-shadow: 0 16px 40px rgba(15, 23, 42, 0.1); transform: translateY(-2px); }
  .mcard__media { aspect-ratio: 4 / 3; background: var(--color-soft); display: flex; align-items: center; justify-content: center; padding: 0.75rem; }
  .mcard__media img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .mcard__ph { color: var(--color-muted); font-size: 0.85rem; }
  .mcard__body { padding: 0.85rem 0.95rem 1rem; display: flex; flex-direction: column; gap: 0.35rem; }
  .mcard__brand { font-size: 0.74rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); }
  .mcard__title { font-weight: 700; color: var(--color-text); text-decoration: none; line-height: 1.3; font-size: 0.98rem; }
  .mcard__title:hover { color: var(--color-brand); }
  .mcard__meta { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .mcard__rating { font-size: 0.82rem; font-weight: 700; color: #b45309; background: #fef3c7; padding: 0.1rem 0.45rem; border-radius: 999px; }
  .mcard__price { font-weight: 700; font-size: 0.92rem; }
  .mcard__updated { font-size: 0.7rem; color: var(--color-muted); }
  .mcard__actions { display: flex; gap: 0.5rem; margin-top: 0.35rem; }
  .mcard__buy { flex: 1; text-align: center; background: var(--color-accent); color: #fff; font-weight: 700; padding: 0.45rem; border-radius: 999px; text-decoration: none; font-size: 0.82rem; }
  .mcard__buy:hover { background: #15803d; }
  .mcard__review { flex: 1; text-align: center; border: 1px solid var(--color-line); color: var(--color-brand); font-weight: 600; padding: 0.45rem; border-radius: 999px; text-decoration: none; font-size: 0.82rem; }
  .mcard__review:hover { background: var(--color-soft); }

  .quizband { margin: 3rem 0 0; padding: 2rem 2rem; background: var(--color-soft); border: 1px solid var(--color-line); border-radius: 18px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; flex-wrap: wrap; }
  .quizband__text h2 { margin: 0 0 0.35rem; font-size: 1.5rem; }
  .quizband__text p { margin: 0; color: var(--color-muted); max-width: 52ch; }

  .tile-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.85rem; }
  .tile { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 1.1rem 1.25rem; border: 1px solid var(--color-line); border-radius: 12px; background: #fff; text-decoration: none; color: var(--color-text); font-weight: 600; transition: border-color 0.12s ease, background 0.12s ease; }
  .tile:hover { border-color: var(--color-brand); background: var(--color-soft); }
  .tile--accent { background: rgba(22, 163, 74, 0.07); border-color: rgba(22, 163, 74, 0.3); color: #15803d; }
  .tile__arrow { color: var(--color-muted); }

  .brand-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 0.6rem; }
  .bpill { display: flex; flex-direction: column; gap: 2px; padding: 0.6rem 0.8rem; border: 1px solid var(--color-line); border-radius: 10px; background: #fff; text-decoration: none; transition: border-color 0.12s ease, background 0.12s ease; }
  .bpill:hover { border-color: rgba(111, 78, 55, 0.45); background: var(--color-soft); }
  .bpill__name { font-weight: 700; color: var(--color-text); font-size: 0.92rem; }
  .bpill__meta { font-size: 0.76rem; color: var(--color-muted); }

  .trust { margin: 3.5rem 0 1rem; padding: 2.5rem 2rem; background: #14110e; color: #ece6df; border-radius: 18px; text-align: center; }
  .trust h2 { margin: 0 0 1.5rem; font-size: clamp(1.4rem, 3vw, 1.9rem); }
  .trust__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; text-align: left; }
  .trust__item h3 { margin: 0 0 0.4rem; color: #fff; font-size: 1.1rem; }
  .trust__item p { margin: 0; color: #b7ada1; font-size: 0.92rem; }
  .trust__link { display: inline-block; margin-top: 1.75rem; color: #7ee0a3; font-weight: 700; text-decoration: none; }
  .trust__link:hover { text-decoration: underline; }

  @media (max-width: 680px) { .trust__grid { grid-template-columns: 1fr; } }
</style>
