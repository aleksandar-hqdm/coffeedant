---
import nav from '../../data/nav.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { machines as catalogMachines, TYPE_LABEL, MILK_LABEL } from '../../lib/catalog';

type Brand = { brand: string; slug: string; route: string; hubRoute: string | null; count: number; avgRating: number | null; models: any[] };
const catalog = (nav as { catalog: Brand[] }).catalog;

export async function getStaticPaths() {
  const cat = (nav as { catalog: Brand[] }).catalog;
  return cat.map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props as { brand: Brand };
const rows = catalogMachines
  .filter((m) => m.brand === brand.brand)
  .sort((a, b) => (b.rating ?? -1) - (a.rating ?? -1));
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Espresso Machines', url: '/machines/' },
  { name: brand.brand, url: brand.route },
];
const desc = `Compare every ${brand.brand} espresso machine we have reviewed${brand.avgRating ? `, average rating ${brand.avgRating} out of 5` : ''}: price, rating, type, milk system, and grinder, side by side.`;
---
<BaseLayout title={`${brand.brand} Espresso Machines: Compared`} description={desc} breadcrumbs={crumbs}>
  <div class="brand-page">
    <header class="brand-hero">
      <h1>{brand.brand} Espresso Machines</h1>
      <p class="brand-hero__meta">
        {brand.count} {brand.count === 1 ? 'review' : 'reviews'}
        {brand.avgRating && <span> · average rating <strong>★ {brand.avgRating} / 5</strong></span>}
      </p>
      {brand.hubRoute && <a class="brand-hero__guide" href={brand.hubRoute}>Read the {brand.brand} buying guide &rarr;</a>}
    </header>

    <div class="ctable-wrap">
      <table class="ctable">
        <thead>
          <tr>
            <th scope="col">Machine</th>
            <th scope="col">Rating</th>
            <th scope="col">Price</th>
            <th scope="col">Type</th>
            <th scope="col">Milk</th>
            <th scope="col">Grinder</th>
            <th scope="col"><span class="sr">Links</span></th>
          </tr>
        </thead>
        <tbody>
          {rows.map((m) => (
            <tr>
              <th scope="row" class="ct-machine">
                <a class="ct-thumb" href={m.route}>{m.image ? <img src={m.image} alt={m.label} loading="lazy" /> : <span class="ct-ph">No image</span>}</a>
                <a class="ct-name" href={m.route}>{m.label}</a>
              </th>
              <td data-label="Rating">{m.rating ? <span class="ct-rating">★ {m.rating}</span> : <span class="ct-na">n/a</span>}</td>
              <td data-label="Price">{m.displayPrice || <span class="ct-na">See Amazon</span>}</td>
              <td data-label="Type">{TYPE_LABEL[m.type] || m.type}</td>
              <td data-label="Milk">{MILK_LABEL[m.milk] || m.milk}</td>
              <td data-label="Grinder">{m.grinder ? 'Yes' : 'No'}</td>
              <td class="ct-actions">
                <a class="ct-buy" href={m.buyUrl} target="_blank" rel="nofollow sponsored noopener">Price</a>
                <a class="ct-review" href={m.route}>Review</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="ctable-note">Prices update weekly from Amazon. Some boutique models are not sold on Amazon; choose "See Amazon" to check current listings.</p>
  </div>
</BaseLayout>

<style>
  .brand-page { max-width: var(--container); margin: 0 auto; padding: 1.5rem 1.25rem 2rem; }
  .brand-hero { padding: 1rem 0 1.5rem; border-bottom: 1px solid var(--color-line); margin-bottom: 1.5rem; }
  .brand-hero h1 { margin: 0 0 0.35rem; font-size: clamp(1.7rem, 4vw, 2.3rem); }
  .brand-hero__meta { margin: 0; color: var(--color-muted); }
  .brand-hero__meta strong { color: var(--color-accent); }
  .brand-hero__guide { display: inline-block; margin-top: 0.6rem; color: var(--color-brand); font-weight: 600; text-decoration: none; }
  .brand-hero__guide:hover { text-decoration: underline; }

  .ctable-wrap { overflow-x: auto; border: 1px solid var(--color-line); border-radius: 14px; }
  .ctable { width: 100%; border-collapse: collapse; min-width: 720px; }
  .ctable thead th { text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); padding: 0.85rem 0.9rem; border-bottom: 1px solid var(--color-line); background: var(--color-soft); }
  .ctable tbody tr { border-bottom: 1px solid var(--color-line); }
  .ctable tbody tr:last-child { border-bottom: 0; }
  .ctable td, .ctable th[scope="row"] { padding: 0.7rem 0.9rem; font-size: 0.92rem; vertical-align: middle; }
  .ct-machine { display: flex; align-items: center; gap: 0.75rem; min-width: 240px; font-weight: 400; }
  .ct-thumb { flex: none; width: 54px; height: 54px; border-radius: 8px; background: var(--color-soft); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .ct-thumb img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .ct-ph { font-size: 0.6rem; color: var(--color-muted); text-align: center; }
  .ct-name { font-weight: 700; color: var(--color-text); text-decoration: none; line-height: 1.3; }
  .ct-name:hover { color: var(--color-brand); }
  .ct-rating { font-weight: 700; color: #b45309; background: #fef3c7; padding: 0.1rem 0.45rem; border-radius: 999px; white-space: nowrap; }
  .ct-na { color: var(--color-muted); }
  .ct-actions { white-space: nowrap; }
  .ct-buy { display: inline-block; background: var(--color-accent); color: #fff; font-weight: 700; padding: 0.4rem 0.8rem; border-radius: 999px; text-decoration: none; font-size: 0.82rem; margin-right: 0.35rem; }
  .ct-buy:hover { background: #15803d; }
  .ct-review { display: inline-block; color: var(--color-brand); font-weight: 600; text-decoration: none; font-size: 0.82rem; }
  .ct-review:hover { text-decoration: underline; }
  .ctable-note { color: var(--color-muted); font-size: 0.82rem; margin: 0.85rem 0 0; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>
