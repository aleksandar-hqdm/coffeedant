---
import nav from '../../data/nav.json';
import amazon from '../../data/amazon.json';
import BaseLayout from '../../layouts/BaseLayout.astro';

type Model = { label: string; route: string; image: string | null; rating: number | null; price: string | null; asin: string | null };
type Brand = { brand: string; slug: string; route: string; hubRoute: string | null; count: number; avgRating: number | null; models: Model[] };

const catalog = (nav as { catalog: Brand[] }).catalog;
const amz = amazon as Record<string, { image?: string; price?: string }>;

export async function getStaticPaths() {
  const cat = (nav as { catalog: Brand[] }).catalog;
  return cat.map((b) => ({ params: { slug: b.slug }, props: { brand: b } }));
}

const { brand } = Astro.props as { brand: Brand };
// Prefer live Amazon image/price when available; otherwise fall back to the
// product image from the review and show no price until live data exists.
const models = brand.models.map((m) => ({
  ...m,
  image: (m.asin && amz[m.asin]?.image) || m.image,
  livePrice: m.asin ? amz[m.asin]?.price ?? null : null,
}));
const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Espresso Machines', url: '/espresso-machine/' },
  { name: brand.brand, url: brand.route },
];
const desc = `Every ${brand.brand} espresso machine we have reviewed${brand.avgRating ? `, with an average rating of ${brand.avgRating} out of 5` : ''}. Compare models and read the full reviews.`;
---
<BaseLayout title={`${brand.brand} Espresso Machines`} description={desc} breadcrumbs={crumbs}>
  <div class="brand-page">
    <header class="brand-hero">
      <h1>{brand.brand} Espresso Machines</h1>
      <p class="brand-hero__meta">
        {brand.count} {brand.count === 1 ? 'review' : 'reviews'}
        {brand.avgRating && <span> · average rating <strong>★ {brand.avgRating} / 5</strong></span>}
      </p>
      {brand.hubRoute && <a class="brand-hero__guide" href={brand.hubRoute}>Read the {brand.brand} buying guide &rarr;</a>}
    </header>

    <div class="machine-grid">
      {models.map((m) => (
        <a class="machine-card" href={m.route}>
          <div class="machine-card__media">
            {m.image ? <img src={m.image} alt={m.label} loading="lazy" /> : <div class="machine-card__ph">No image</div>}
          </div>
          <div class="machine-card__body">
            <h2 class="machine-card__title">{m.label}</h2>
            <div class="machine-card__meta">
              {m.rating
                ? <span class="machine-card__rating">★ {m.rating} / 5</span>
                : <span class="machine-card__rating machine-card__rating--none">Reviewed</span>}
              {m.livePrice && <span class="machine-card__price">${m.livePrice}</span>}
            </div>
            <span class="machine-card__cta">Read review &rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .brand-page { max-width: var(--container); margin: 0 auto; padding: 1.5rem 1.25rem 2rem; }
  .brand-hero { padding: 1rem 0 1.5rem; border-bottom: 1px solid var(--color-line); margin-bottom: 1.75rem; }
  .brand-hero h1 { margin: 0 0 0.35rem; font-size: clamp(1.7rem, 4vw, 2.3rem); }
  .brand-hero__meta { margin: 0; color: var(--color-muted); }
  .brand-hero__meta strong { color: var(--color-accent); }
  .brand-hero__guide { display: inline-block; margin-top: 0.6rem; color: var(--color-brand); font-weight: 600; text-decoration: none; }
  .brand-hero__guide:hover { text-decoration: underline; }

  .machine-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 1.25rem; }
  .machine-card {
    display: flex; flex-direction: column; border: 1px solid var(--color-line); border-radius: 14px;
    overflow: hidden; background: #fff; text-decoration: none; color: inherit;
    transition: box-shadow 0.15s ease, transform 0.15s ease, border-color 0.15s ease;
  }
  .machine-card:hover { box-shadow: 0 16px 40px rgba(15, 23, 42, 0.1); transform: translateY(-2px); border-color: rgba(111, 78, 55, 0.3); }
  .machine-card__media { aspect-ratio: 4 / 3; background: var(--color-soft); display: flex; align-items: center; justify-content: center; padding: 0.75rem; }
  .machine-card__media img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .machine-card__ph { color: var(--color-muted); font-size: 0.85rem; }
  .machine-card__body { padding: 0.9rem 1rem 1rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .machine-card__title { margin: 0; font-size: 1rem; line-height: 1.3; }
  .machine-card__meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .machine-card__rating { font-size: 0.85rem; font-weight: 700; color: #b45309; background: #fef3c7; padding: 0.1rem 0.5rem; border-radius: 999px; }
  .machine-card__rating--none { color: var(--color-muted); background: var(--color-soft); font-weight: 600; }
  .machine-card__price { font-size: 0.9rem; font-weight: 700; color: var(--color-text); }
  .machine-card__cta { margin-top: 0.15rem; font-size: 0.85rem; font-weight: 600; color: var(--color-brand); }
</style>
