---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const posts = pages
  .filter((p) => p.data.type === 'blog')
  .sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)));
---
<BaseLayout
  title="Coffee Brewing Blog"
  description="Brewing technique, grind, dose, and extraction guides from Coffeedant."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog/' }]}
>
  <div class="cd-article">
    <h1>Brewing Blog</h1>
    <p>Technique guides on grind, dose, ratio, and extraction.</p>
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={p.data.route}>{p.data.breadcrumb || p.data.title}</a>
          {p.data.description && <p>{p.data.description}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .post-list { list-style: none; padding: 0; margin: 2rem 0 0; }
  .post-list li { padding: 1.1rem 0; border-bottom: 1px solid var(--color-line); }
  .post-list a { font-size: 1.2rem; font-weight: 700; text-decoration: none; color: var(--color-brand); }
  .post-list p { margin: 0.35rem 0 0; color: var(--color-muted); font-size: 0.95rem; }
</style>
