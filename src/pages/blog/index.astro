---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const pages = await getCollection('pages');
const posts = pages
  .filter((p) => p.data.type === 'blog')
  .sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)));
---
<BaseLayout
  title="Coffee Brewing Blog"
  description="Brewing technique, grind, dose, and extraction guides from Coffeedant."
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: 'Blog', url: '/blog/' }]}
>
  <div class="cd-article">
    <h1>Brewing Blog</h1>
    <p>Technique guides on grind, dose, ratio, and extraction.</p>
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a href={p.data.route}>{p.data.breadcrumb || p.data.title}</a>
          {p.data.description && <p>{p.data.description}</p>}
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .post-list { list-style: none; padding: 0; margin: 2.5rem 0 0; }
  .post-list li { padding: 1.4rem 0; border-bottom: 1px solid var(--line-soft); transition: padding-left 0.2s var(--ease); }
  .post-list li:hover { padding-left: 0.4rem; }
  .post-list a { font-family: var(--font-display); font-optical-sizing: auto; font-size: 1.4rem; font-weight: 540; letter-spacing: -0.01em; text-decoration: none; color: var(--ink); line-height: 1.25; }
  .post-list a:hover { color: var(--copper-deep); }
  .post-list p { margin: 0.45rem 0 0; color: var(--ink-2); font-size: 0.98rem; max-width: 70ch; }
</style>
